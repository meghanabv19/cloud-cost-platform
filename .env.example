# =====================================================================
# Copy to .env.local (never committed) and fill in what you need.
# Every value is read from the environment only — nothing is hard-coded.
# You do NOT need all of these at once; each source reads only its own.
# =====================================================================

# ---- Shared: warehouse + retention -----------------------------------
DUCKDB_PATH=data/warehouse.duckdb
RETENTION_HOT_DAYS=15

# ---- Cloudflare R2 (cold archive, S3-compatible) ---------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT is derived from R2_ACCOUNT_ID if left blank
R2_ENDPOINT=

# ---- Email alerts (Gmail app password recommended) -------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=            # Gmail App Password, NOT your login password
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ---- Claude (Anthropic Admin API) ------------------------------------
ANTHROPIC_ADMIN_KEY=      # sk-ant-admin...

# ---- AWS CUR ---------------------------------------------------------
AWS_SOURCE=sample         # sample (default) | live
AWS_CUR_SAMPLE_PATH=sample-data/aws_cur_sample.parquet
# live mode only:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_CUR_S3_BUCKET=
AWS_CUR_S3_PREFIX=

# ---- GCP (primary cost source) ---------------------------------------
# Provide EITHER an inline SA key JSON, or a path to the key file:
GCP_SA_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_BILLING_BQ_PROJECT=
GCP_BILLING_BQ_DATASET=
GCP_BILLING_BQ_TABLE=      # e.g. gcp_billing_export_resource_v1_XXXXXX
GCP_BILLING_ACCOUNT_ID=

# ---- GitHub ----------------------------------------------------------
GH_BILLING_TOKEN=          # PAT with billing:read (falls back to GITHUB_TOKEN)
GITHUB_ORG=
GITHUB_USERNAME=

# ---- Supabase (Management API) ---------------------------------------
SUPABASE_ACCESS_TOKEN=     # sbp_...
SUPABASE_ORG_ID=

# ---- dbt Cloud -------------------------------------------------------
DBT_CLOUD_API_TOKEN=
DBT_CLOUD_ACCOUNT_ID=
DBT_CLOUD_API_HOST=cloud.getdbt.com

# ---- Vercel ----------------------------------------------------------
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ---- Threshold overrides (optional) ----------------------------------
# THRESHOLD_GCP=120
