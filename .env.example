# =====================================================================
# Copy to .env.local (never committed) and fill in what you need.
# Every value is read from the environment only — nothing is hard-coded.
# You do NOT need all of these at once; each source reads only its own.
# =====================================================================

# ---- Shared: warehouse + retention -----------------------------------
DUCKDB_PATH=data/warehouse.duckdb
RETENTION_HOT_DAYS=15

# ---- Cloudflare R2 (cold archive, S3-compatible) ---------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT is derived from R2_ACCOUNT_ID if left blank
R2_ENDPOINT=

# ---- Email alerts (Gmail app password recommended) -------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=            # Gmail App Password, NOT your login password
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ---- Claude (Anthropic Admin API) ------------------------------------
ANTHROPIC_ADMIN_KEY=      # sk-ant-admin...

# ---- DuckDB (self-monitoring) ----------------------------------------
# No credentials — DuckDB reports its own warehouse usage via DUCKDB_PATH above.

# ---- GitHub ----------------------------------------------------------
GH_BILLING_TOKEN=          # PAT with billing:read (falls back to GITHUB_TOKEN)
GITHUB_ORG=
GITHUB_USERNAME=

# ---- Supabase (Management API) ---------------------------------------
SUPABASE_ACCESS_TOKEN=     # sbp_...
SUPABASE_ORG_ID=

# ---- dbt Cloud -------------------------------------------------------
DBT_CLOUD_API_TOKEN=
DBT_CLOUD_ACCOUNT_ID=
DBT_CLOUD_API_HOST=cloud.getdbt.com

# ---- Vercel ----------------------------------------------------------
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ---- Threshold overrides (optional) ----------------------------------
# THRESHOLD_GCP=120
